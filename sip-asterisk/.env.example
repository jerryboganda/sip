# ============================================================================
# SIP Asterisk Trunk - Environment Configuration
# Copy this file to ".env" and fill in the REAL values from your SIP provider.
# Any value still containing CHANGE_ME will block deployment (render fails).
# This file (and .env) contain NO secrets for IP-auth trunks (only IPs/CLI),
# but treat .env as configuration you do not paste publicly.
# ============================================================================

# --- Server identity ---
TZ=Asia/Karachi
PUBLIC_IP=185.252.233.186
SIP_DOMAIN=sip.polytronx.com

# --- SIP signaling / RTP ports (defaults are standard; change only if told) ---
SIP_PORT=5060
RTP_START=10000
RTP_END=20000

# --- Provider details (GET THESE FROM YOUR SIP TRUNK PROVIDER) ---
# The gateway / outbound proxy the server sends calls TO:
PROVIDER_GATEWAY_IP=CHANGE_ME_PROVIDER_GATEWAY_IP

# The provider's SIGNALING source IP, used to authenticate inbound traffic
# (pjsip type=identify match=). If the provider has several signaling IPs,
# put the primary one here and add extra "match=" lines in config-templates/pjsip.conf.
PROVIDER_SIGNALING_IP=CHANGE_ME_PROVIDER_SIGNALING_IP

# --- Caller ID (CLI) — PASS-THROUGH, no local restriction ---
# The dialplan forwards whatever caller ID, name, number and destination the
# application presents, unmodified. The PROVIDER screens CLI / numbers on their
# side, so NO AUTHORIZED_CLI is configured here (leave this section as-is).

# ============================================================================
# Firewall allowlists (used by scripts/03-firewall-setup.sh ONLY).
# Space-separated lists are supported for multiple provider IPs.
# ============================================================================

# Your admin/office public IP (SSH :22 and NPM admin :81 are limited to this).
ADMIN_IP=CHANGE_ME_ADMIN_PUBLIC_IP

# All provider SIGNALING IPs to allow on the SIP port (space-separated).
PROVIDER_SIGNALING_IPS=CHANGE_ME_PROVIDER_SIGNALING_IP

# All provider RTP/media IPs to allow on the RTP range (space-separated).
# Often the same as signaling; confirm with the provider.
PROVIDER_RTP_IPS=CHANGE_ME_PROVIDER_RTP_IP
